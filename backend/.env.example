# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (default: local Ollama) ---
LLM_PROVIDER=ollama                 # ollama | anthropic | openai
LOCAL_MODEL=qwen2.5:7b              # any installed Ollama model (e.g. gemma4:e4b)

# --- Hosted fallbacks (only used if LLM_PROVIDER is set to them) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Movie knowledge base (optional but recommended) ---
# Free key: https://www.themoviedb.org/signup -> Settings -> API -> Developer (v3).
# Then run:  python -m app.knowledge.ingest_tmdb   (top ~5,000 titles)
# Seed a starter KB without any key:  python -m app.knowledge.seed
# Index your own subtitles:  python -m app.knowledge.ingest_subtitles /path/to/srts
# TMDB_API_KEY=
# SCENE_SENSE_KB_DEPTH=5000

# --- Content filter ---
# FILTER_STRICT=true                 # strict also blocks R-rated-adjacent terms

# --- Pipeline overrides ---
# SCENE_SENSE_WHISPER_MODEL=small    # tiny|base|small|medium|large-v3
# SCENE_SENSE_CLIP_PAD=1.5
# SCENE_SENSE_CLIP_MAX=45
# SCENE_SENSE_HOST=127.0.0.1
# SCENE_SENSE_PORT=8000
# SCENE_SENSE_LOG_LEVEL=INFO
