# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (default: local Ollama) ---
LLM_PROVIDER=ollama                 # ollama | anthropic | openai
LOCAL_MODEL=qwen2.5:7b              # any installed Ollama model (e.g. gemma4:e4b)

# --- Hosted fallbacks (only used if LLM_PROVIDER is set to them) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Public-statements knowledge base (optional but recommended) ---
# Seed a starter KB (well-documented public speeches/statements), no key needed:
#   python -m app.knowledge.seed
# Ingest your own structured events (JSON) — see knowledge/ingest_events.py:
#   python -m app.knowledge.ingest_events /path/to/events.json
# Index your own transcripts (.srt of speeches/interviews/press conferences):
#   python -m app.knowledge.ingest_subtitles /path/to/srts
# VERBATIM_KB_DEPTH=5000

# --- Content filter ---
# FILTER_STRICT=true                 # strict also blocks R-rated-adjacent terms

# --- Pipeline overrides ---
# VERBATIM_WHISPER_MODEL=small    # tiny|base|small|medium|large-v3
# VERBATIM_CLIP_PAD=1.5
# VERBATIM_CLIP_MAX=45
# VERBATIM_HOST=127.0.0.1
# VERBATIM_PORT=8000
# VERBATIM_LOG_LEVEL=INFO
